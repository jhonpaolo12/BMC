rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Orders placed from the app.
    //
    // Every order is owned by the signed-in Firebase Auth account
    // (`user_id` == request.auth.uid). That is what lets the same
    // shopper see the same history on Chrome and on Android without
    // ever exposing the whole collection:
    //
    //   orders.where('user_id', '==', uid)  ->  list (owner only)
    //   orders.doc(orderId).get()           ->  get  (payment screens)
    //   orders.add({...})                   ->  create (owner only)
    //
    // Status changes are written by the Supabase relay using a service
    // account, which bypasses these rules entirely.
    match /orders/{orderId} {

      // Checkout may create an order, but only as "unpaid" and only
      // under the caller's own uid.
      allow create: if isSignedIn()
        && isValidNewOrder(request.resource.data);

      // Payment status screen and deep links may read one order by its
      // ID. The document ID is unguessable, and this path must keep
      // working before the auth session has been restored.
      allow get: if true;

      // Only the owner may query; the query must be filtered by their
      // own uid. No browsing the collection.
      allow list: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      // Clients may never change or remove an order.
      allow update, delete: if false;
    }

    // Catalog products: public read-only. The storefront needs to read
    // (and list) the catalog, but only the project owner can write it.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Shape check for a brand-new order, so a client cannot invent
    // server-owned fields (payment link, Xendit session id, paid_at, ...)
    // or create an order that already claims to be paid or belongs to
    // somebody else.
    //
    // Customer details are collected at checkout and must be present,
    // but order_notes stays optional (empty string is accepted).
    function isValidNewOrder(order) {
      return order.keys().hasAll([
          'user_id',
          'items',
          'total',
          'payment_method',
          'payment_status',
          'order_status',
          'status',
          'customer_name',
          'phone',
          'address',
          'city',
          'postal_code',
          'order_notes',
          'created_at',
          'updated_at'
        ])
        && order.keys().hasOnly([
          'user_id',
          'items',
          'total',
          'payment_method',
          'payment_status',
          'order_status',
          'status',
          'customer_name',
          'phone',
          'address',
          'city',
          'postal_code',
          'order_notes',
          'created_at',
          'updated_at'
        ])
        && order.user_id is string
        && order.user_id == request.auth.uid
        && order.items is list
        && order.items.size() > 0
        && order.items.size() <= 100
        && order.total is number
        && order.total >= 0
        && order.total <= 1000000
        && order.payment_method == 'Xendit'
        && order.payment_status == 'pending'
        && order.order_status == 'pending'
        && order.status == 'PENDING'
        && order.customer_name is string
        && order.customer_name.size() >= 2
        && order.customer_name.size() <= 100
        && order.phone is string
        && order.phone.size() >= 7
        && order.phone.size() <= 20
        && order.address is string
        && order.address.size() >= 5
        && order.address.size() <= 300
        && order.city is string
        && order.city.size() >= 2
        && order.city.size() <= 100
        && order.postal_code is string
        && order.postal_code.size() >= 3
        && order.postal_code.size() <= 10
        && order.order_notes is string
        && order.order_notes.size() <= 500
        && order.created_at == request.time
        && order.updated_at == request.time;
    }
  }
}
